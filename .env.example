# The reviewer stack uses its own Ollama container with qwen3:1.7b.
# These optional settings apply to compose.ollama.yml, which defaults to
# http://host.docker.internal:11434 and llama3:latest.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Optional OpenAI settings for running the backend without Ollama.
OPENAI_API_KEY=
# Set an exact model ID available to your project.
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
